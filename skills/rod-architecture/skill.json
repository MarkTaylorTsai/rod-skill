{
  "manifest_version": "1.0.0",
  "id": "rod-architecture",
  "name": "ROD Architecture",
  "display_name": "ROD Architecture — Ratchet-Oriented Architecture",
  "version": "0.9.0",
  "description": "Apply Ratchet-Oriented Architecture when creating new systems or making structural software changes. Use this skill to separate Stable Core from Evolvable Surfaces and make software observable, versioned, testable, reversible, and safe for AI-assisted evolution.",
  "license": "MIT",
  "language": "en",
  "tags": [
    "ai-agent",
    "architecture-pattern",
    "ratchet-oriented-architecture",
    "ratchet-oriented-development",
    "stable-core",
    "evolvable-surfaces",
    "software-quality",
    "release-gates"
  ],
  "entrypoint": {
    "type": "markdown",
    "path": "skills/rod-architecture/SKILL.md"
  },
  "runtime": {
    "type": "none",
    "requires_network": false,
    "requires_filesystem_write": false,
    "requires_shell": false
  },
  "configuration": {
    "mode": "${ROD_SKILL_MODE:-standard}",
    "log_level": "${ROD_SKILL_LOG_LEVEL:-INFO}",
    "defaults_path": "${ROD_SKILL_DEFAULTS_PATH:-config/rod.defaults.json}"
  },
  "security": {
    "secrets_required": [],
    "secret_handling_policy": "Do not hardcode secrets, tokens, API keys, credentials, private keys, seed phrases, production data, private user data, or sensitive payloads. Use environment variables or the host platform's secret manager. Never commit .env files.",
    "data_handling": {
      "stores_user_data": false,
      "logs_sensitive_data": false,
      "requires_redaction": true
    }
  },
  "capabilities": [
    "apply_ratchet_oriented_architecture",
    "identify_stable_core_boundaries",
    "design_evolvable_surfaces",
    "define_fitness_checks",
    "design_reversible_patches",
    "define_promotion_gates"
  ],
  "files": [
    {
      "path": "skills/rod-architecture/SKILL.md",
      "role": "instructions",
      "required": true
    },
    {
      "path": "config/rod.defaults.json",
      "role": "configuration_defaults",
      "required": false
    }
  ],
  "compatibility": {
    "agent_platforms": [
      "generic-ai-agent",
      "manifest-based-agent-runtime"
    ],
    "minimum_python_for_helpers": "3.10"
  },
  "source": {
    "repository": "https://github.com/MarkTaylorTsai/rod-skill",
    "homepage": "https://github.com/MarkTaylorTsai/rod-skill",
    "issues": "https://github.com/MarkTaylorTsai/rod-skill/issues"
  }
}
