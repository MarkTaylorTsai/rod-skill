# ROD Skill helper configuration
# Example only. Do not commit real secrets, tokens, private endpoints, or sensitive values.
# Copy this file to .env for local use. Never commit .env.

# Default operating mode for helper tooling: lightweight, standard, or strict.
ROD_SKILL_MODE=standard

# Helper log level.
ROD_SKILL_LOG_LEVEL=INFO

# Optional external defaults path.
ROD_SKILL_DEFAULTS_PATH=config/rod.defaults.json

# Do not put real API keys, tokens, credentials, private keys, or production secrets here.
# Use your deployment platform's secret manager or a local untracked .env file.
