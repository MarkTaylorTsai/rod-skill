{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://github.com/MarkTaylorTsai/rod-skill/schemas/skill.schema.json",
  "title": "Portable ROD Skill Manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "id",
    "name",
    "version",
    "description",
    "entrypoint",
    "security"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entrypoint": {
      "type": "object",
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "const": "markdown"
        },
        "path": {
          "type": "string",
          "pattern": "(^|/)SKILL\\.md$"
        }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "requires_network": {
          "type": "boolean"
        },
        "requires_filesystem_write": {
          "type": "boolean"
        },
        "requires_shell": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "configuration": {
      "type": "object"
    },
    "security": {
      "type": "object",
      "required": [
        "secret_handling_policy"
      ],
      "properties": {
        "secrets_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secret_handling_policy": {
          "type": "string",
          "minLength": 1
        },
        "data_handling": {
          "type": "object",
          "properties": {
            "stores_user_data": {
              "type": "boolean"
            },
            "logs_sensitive_data": {
              "type": "boolean"
            },
            "requires_redaction": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "required"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "compatibility": {
      "type": "object"
    },
    "source": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
